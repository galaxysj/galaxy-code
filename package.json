{
  "name": "galaxy-code",
  "productName": "Galaxy Code",
  "version": "0.1.0",
  "description": "A desktop agent manager for coding agents.",
  "main": "out/main/index.js",
  "author": "Galaxy Code",
  "license": "MIT",
  "private": true,
  "scripts": {
    "prepare:pty": "node scripts/prepare-pty.mjs",
    "predev": "npm run prepare:pty",
    "prestart": "npm run prepare:pty",
    "prebuild": "npm run prepare:pty",
    "predist": "npm run prepare:pty",
    "predist:dmg": "npm run prepare:pty",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "icon": "node scripts/make-icon.mjs",
    "dist": "npm run icon && electron-vite build && electron-builder --mac --dir",
    "dist:dmg": "npm run icon && electron-vite build && electron-builder --mac"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.276",
    "@galaxysj/v4a": "0.1.0",
    "@modelcontextprotocol/sdk": "^1.20.0",
    "@vscode/ripgrep": "^1.15.14",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "diff": "^8.0.2",
    "fast-glob": "^3.3.3",
    "node-pty": "^1.1.0",
    "turndown": "^7.2.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/turndown": "^5.0.5",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^41.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.545.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.4",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "zustand": "^5.0.8"
  },
  "build": {
    "appId": "dev.galaxycode.app",
    "productName": "Galaxy Code",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**",
      "node_modules/@vscode/ripgrep/**",
      "node_modules/@vscode/ripgrep-*/**",
      "node_modules/@anthropic-ai/claude-agent-sdk/**",
      "node_modules/@anthropic-ai/claude-agent-sdk-*/**"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "target": [
        "dmg"
      ],
      "identity": null,
      "extendInfo": {
        "CFBundleDisplayName": "Galaxy Code",
        "NSAppleEventsUsageDescription": "Galaxy Code opens Terminal to sign in to AI account CLIs."
      }
    },
    "extraMetadata": {
      "name": "galaxy-code"
    }
  }
}
